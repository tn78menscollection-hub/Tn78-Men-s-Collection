# TN78 Web Storefront Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal Docker/Kubernetes/SSR backend URL (defaults to http://127.0.0.1:8001 if omitted)
INTERNAL_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key
NEXT_PUBLIC_UPI_VPA=your-upi-vpa@bank
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Storage Configuration (Server-side only - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=products
